; v80, (C) Kroc Camen 2023-2025, MIT License
; z80 opcode tree / emit
;
.BLOCK  "code-emit"

emitOpcode:
;===============================================================================
; write CPU opcode bytes, parsing any required parameters:
;
; in:   A, D            opcode flags byte from the opcode table
;       E               opcode byte
;       HL              heap address for any deferred expressions
;
; out:  HL              deferred parameters values may push to heap
;       A, BC, DE       (clobbered)
;===============================================================================
        ; FIXME im 0,1,2                        $46 $56 $5E
        ;       rst 0,8,10,18,20,28,30,38       $C7 $CF $D7 $DF $E7 $EF $F7 $FF

        ; opcode with extensions or parameters?
        ;-----------------------------------------------------------------------
        bit     6,      D               ; bit 6 indicates IX or IY
        jr      nz,     @ixy            ; go handle IX|IY madness...

        ; is it a $CB or $ED extended opcode?
        ;
        bit     4,      D               ; bit 4 indicates an extended opcode
        jr      z,      @noext          ; not extended? skip over $CB/$ED

        ; output $CB or $ED opcode extension byte:
        ;
        and     %00100010               ; bit 5&1 = $22 ($ED) or $00 ($CB)
        add     $cb                     ; $CB+$00 = $CB or $CB+$22 = $ED
        ld      [IY+0], A               ; emit $CB|$ED prefix byte
        inc     IY                      ; move to next byte in code-segment
        inc     IX                      ; increment virtual program-counter
        ld      A,      D               ; restore bits

        ; at this point, all parameters (if any) follow the opcode,
        ; so we can output the opcode now and forget it
        ;-----------------------------------------------------------------------
@noext: ld      [IY+0], E               ; emit opcode byte
        inc     IY                      ; move to next byte in code-segment
        inc     IX                      ; increment virtual program-counter
        ;-----------------------------------------------------------------------

        ; any parameters?
        ;
        ; bit 2 indicates any kind of parameter for non IX|IY opcodes,
        ; i.e. 8 / 16 bit immediate, or relative (bit 3). there are no
        ; 2-parameter Z80 opcodes without IX|IY so 1 param can be assumed
        ;
        ; FIXME: this conflicts with relative flag
        ;
        bit     2,      D               ; if no parameters, extensions
        ret     z                       ;  have been done, finish now!

        ; a single, 1 or 2 byte parameter:
        and     %00000001               ; LSB indicates 2-bytes
        add     1                       ; param has at least 1-byte

        bit     3,      D               ; relative jump?
        jr      z,      +               ; skip over the next instruction if not
        or      %10000000               ; add the rel-flag to the param type

+       ; emit the 1st parameter: (saved during instruction parsing)
        ;-----------------------------------------------------------------------
;        ; register A must be param width / relative-flag. note that we delay
;        ; clearing the parameter count (set by `parseInstruction`) to here
;        ; to avoid wasting cycles clearing it on parameterless instructions
;        ;
        ;///////////////////////////////////////////////////////////////////////
        .printA
        ;///////////////////////////////////////////////////////////////////////

@p1:    ld      BC,     [param1+1]      ; retrieve parameter 1 value
        jp      emitValueA              ; write opcode param to code-segment

        ;=======================================================================
        ; handle IX|IY opcodes: (bit 5 chooses between IX & IY)
        ;
@ixy:   and     %00100000               ; isolate bit 5
        or      %11011101               ; map to $DD (IX) or $FD (IY)
        ld      [IY+0], A               ; emit IX|IY prefix byte
        inc     IY                      ; move to next byte in code-segment
        inc     IX                      ; increment virtual program-counter

        ; on the Z80, a combination of $DD|$FB (IX|IY) + $CB opcodes place
        ; the opcode after the offset parameter! if this is the case, we
        ; have to insert the parameter first, then return for the opcode
        ;
        bit     4,      D               ; bit 4 on indicates $CB-extended
        jr      nz,     @cb             ; go handle reverse parameter order

        ; at this point, all parameters (if any) follow the opcode,
        ; so we can output the opcode now and forget it
        ;-----------------------------------------------------------------------
        ld      [IY+0], E               ; emit opcode byte
        inc     IY                      ; move to next byte in code-segment
        inc     IX                      ; increment virtual program-counter
        ;-----------------------------------------------------------------------

        ; bit 3 (offset), bit 2 (8-bit immediate), and
        ; bit 0 (16-bit immediate) indicate parameters
        ;
        ld      A,      D               ; opcode flags byte
        and     %00001101               ; filter out parameter flags
        ret     z                       ; if none, we are finished

        ; there are only two Z80 instructions that use 2 parameters
        ; -- `ld [IX+$aa], $bb` and the matching IY-variant
        ;
        xor     %00001100               ; flip just the bits for 2 params
        jr      z,      @two            ; divert for 2 params!

        ; only one parameter
        ; -- determine parameter width (byte or word)
        ;
        xor     A                       ; set A to zero
        rrc     D                       ; pop off bit 0 of opcode-flags
        adc     1                       ; add that bit, if present

        jr      @p1                     ; write opcode param to code-segment

        ;-----------------------------------------------------------------------
        ; IX|IY + $CB is the edge-case that keeps on giving: at all other
        ; times the IX|IY offset byte follows the opcode, but not here!
        ;
@cb:    ld      [IY+0], $cb             ; emit $CB prefix byte
        inc     IY                      ; move to next byte in code-segment
        inc     IX                      ; increment virtual program-counter
        push    DE                      ; keep opcode until emit time

        ld      A,      1               ; set parameter-width to 1 byte
        call    @p1                     ; write opcode param to code-segment

        pop     DE                      ; retrieve delayed opcode
        ld      [IY+0], E               ; emit opcode byte
        inc     IY                      ; move to next byte in code-segment
        inc     IX                      ; increment virtual program-counter

        ret

        ;-----------------------------------------------------------------------
        ; handle two-parameter instruction special case:
        ;
@two:   inc     A                       ; set the parameter width to 1-byte
        call    @p1                     ; emit 1st parameter to code-segment

        ; emit the 2nd parameter: (saved during instruction parsing)
        ;
@p2:    ld      A,              1       ; NOTE: 2nd param is always 8-bit
        ld      BC,     [param2+1]      ; retrieve parameter 2 value
        jp      emitValueA              ; write opcode param to code-segment

.ENDB
.BLOCK  "data-z80"

; Z80 opcode table:
;===============================================================================
; types of opcodes:
;-------------------------------------------------------------------------------
;             op                ; implied
;    ED       op                ; implied, ED-extended
;       CB    op                ; implied, CB-extended
;             op nn             ; immediate, 8-bit
;             op nn nn          ; immediate, 16-bit
;    ED       op nn nn          ; immediate, 16-bit, ED-extended
;             op rr             ; immediate, relative (i.e. JR | DJNZ)
; DD|FD       op                ; IXY implied
; DD|FD       op rr             ; IXY relative
; DD|FD CB rr op                ; IXY relative, CB-extended: the cursed opcode!
; DD|FD       op rr nn          ; IXY relative, immediate -- 2 parameters!
; DD|FD       op nn nn          ; IXY implied, immediate, 16-bit
;
; opcode flags byte:
;-------------------------------------------------------------------------------
; the opcode tree indicates the end of a branch with an opcode-flags byte
; that describes the opcode prefixes and parameters used:
;
; bit 7 is unused
;
; bit 6 on indicates that the opcode is IX ($DD) or IY ($FD) extended
;
; bit 5 is used to select between extensions; if bit 6 is on,
;       then bit 5 off chooses IX, and bit 5 on chooses IY
;
; bit 4 on indicates a $CB (or $ED) extension. if bit 6 is off (no IX|Y),
;       then bits 5 & 1 on ($22) indicates an $ED extensions, otherwise
;       bits 5 & 1 are off ($00). bits 5 & 1 are combined this way because
;       $CB + $22 = $ED
;
; bit 3 on indicates a relative offset is present. if bit 6 is on, then
;       this is the IX|IY relative offset byte. if bit 6 is off, then this
;       indicates a relative jump offset (e.g. JR | DJNZ)
;
; bit 2 on indicates an immediate parameter. this is separate from the
;       relative offset parameter above as there can be two parameters!
;
; bit 1 is on for $ED extended opcodes
;
; bit 0 on indicates an immediate parameter is 16-bits instead of 8,
;       this is always paired with bit 2, both must be on to be valid
;
OP          = %00000000         ; implied -- no parameters
OP_B        = %00000100         ; bit 2=1: immediate parameter, 8-bits (byte)
OP_W        = %00000101         ; bit 2=1, bit 0=1: immediate 16-bits (word)
OP_R        = %00001000         ; bit 3=1: relative offset param (always byte)
OP_I        = %01000000         ; bit 6=1: IX or IY extended
OP_X        = %01000000         ; bit 6=1, bit 5=0: IX
OP_Y        = %01100000         ; bit 6=1, bit 5=1: IY
OP_IX       = OP_I | OP_X       ; = implied, IX ($DD)
OP_IY       = OP_I | OP_Y       ; = implied, IY ($FD)
OP_CB       = %00010000         ; bit 6=?, bit 4=1, bit 5&1=0: CB-extended
OP_ED       = %00110010         ; bit 6=0, bit 4=1, bit 5&1=1: ED-extended
OP_IXR      = OP_IX | OP_R      ; = immediate, IX ($DD) + relative offset
OP_IYR      = OP_IY | OP_R      ; = immediate, IY ($FD) + relative offset
OP_CBXR     = OP_IXR | OP_CB    ; = extended ($CB), IX ($DD) + relative offset
OP_CBYR     = OP_IYR | OP_CB    ; = extended ($CB), IY ($FD) + relative offset

OP_IXB      = OP_B | OP_IX      ; = IX + immediate 8-bits
OP_IYB      = OP_B | OP_IY      ; = IY + immediate 8-bits
OP_IXRB     = OP_B | OP_IXR     ; = IX ($DD) + offset + immediate (2 params!)
OP_IYRB     = OP_B | OP_IYR     ; = IY ($FD) + offset + immediate (2 params!)
OP_EDW      = OP_W | OP_ED      ; = immediate, extended ($ED), 16-bit!
OP_IXW      = OP_W | OP_IX      ; = immediate, IX ($DD), 16-bit
OP_IYW      = OP_W | OP_IY      ; = immediate, IY ($FD), 16-bit

opcodes:
;===============================================================================
.WORD   a                       ; a..?
.WORD   b                       ; b..?
.WORD   c                       ; c..?
.WORD   d                       ; d..?
.WORD   e                       ; e..?
.WORD   $0000                   ; (no f.. instructions)
.WORD   $0000                   ; (no g.. instructions)
.WORD   h                       ; h..?
.WORD   i                       ; i..?
.WORD   j                       ; j..?
.WORD   $0000                   ; (no k.. instructions)
.WORD   l                       ; l..?
.WORD   $0000                   ; (no m.. instructions)
.WORD   n                       ; n..?
.WORD   o                       ; o..?
.WORD   p                       ; p..?
.WORD   $0000                   ; (no q.. instructions)
.WORD   r                       ; r..?
.WORD   s                       ; s..?
.WORD   $0000                   ; (no t.. instructions)
.WORD   $0000                   ; (no u.. instructions)
.WORD   $0000                   ; (no v.. instructions)
.WORD   $0000                   ; (no w.. instructions)
.WORD   x                       ; x..?
.WORD   $0000                   ; (no y.. instructions)
.WORD   $0000                   ; (no z.. instructions)

a:
;===============================================================================
; NOTE:
; -     parsing is case insensitive; case is only used here to visually
;       distinguish mnemonics from registers and registers from flags
; -     a single space here will match multiple spaces from the input
; -     "$" is expanded to a full expression, i.e. an instruction parameter
; -     all apostrophes in the input are ignored so shadow registers
;       do not need to be defined here
; -     TODO: whitespace is automatically skipped after "[" and before "]"
; -     TODO: "+" can also be "-" and whitespace is automatically
;       skipped either side
;
;       .---------- = number of new chars introduced (i.e. str-length)
;       |       .-- = number of chars re-used from previous line
;       |       |     (with the first character included)
;       V       V
.BYTE   4 *16 | 1, "dc $"       ,$ce, OP_B      ;    CE nn    | adc $nn
.BYTE   4 *16 | 4,    "[HL]"    ,$8e, OP        ;    8E       | adc [HL]
.BYTE   5 *16 | 5,     "IX+$]"  ,$8e, OP_IXR    ; DD 8E nn    | adc [IX±$nn]
.BYTE   4 *16 | 6,      "Y+$]"  ,$8e, OP_IYR    ; FD 8E nn    | adc [IY±$nn]
.BYTE   1 *16 | 4,    "A"       ,$8f, OP        ;    8F       | adc A
.BYTE   1 *16 | 4,    "B"       ,$88, OP        ;    88       | adc B
.BYTE   1 *16 | 4,    "C"       ,$89, OP        ;    89       | adc C
.BYTE   1 *16 | 4,    "D"       ,$8a, OP        ;    8A       | adc D
.BYTE   1 *16 | 4,    "E"       ,$8b, OP        ;    8B       | adc E
.BYTE   1 *16 | 4,    "H"       ,$8c, OP        ;    8C       | adc H
.BYTE   4 *16 | 5,     "L BC"   ,$4a, OP_ED     ; ED 4A       | adc HL BC
.BYTE   2 *16 | 7,       "DE"   ,$5a, OP_ED     ; ED 5A       | adc HL DE
.BYTE   2 *16 | 7,       "HL"   ,$6a, OP_ED     ; ED 6A       | adc HL HL
.BYTE   2 *16 | 7,       "SP"   ,$7a, OP_ED     ; ED 7A       | adc HL SP
.BYTE   1 *16 | 4,    "L"       ,$8d, OP        ;    8D       | adc L
.BYTE   3 *16 | 4,    "IXH"     ,$8c, OP_IX     ; DD 8C       | adc IXH
.BYTE   1 *16 | 6,      "L"     ,$8d, OP_IX     ; DD 8D       | adc IXL
.BYTE   2 *16 | 5,     "YH"     ,$8c, OP_IY     ; FD 8C       | adc IYH
.BYTE   1 *16 | 6,      "L"     ,$8d, OP_IY     ; FD 8D       | adc IYL
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 2,  "d $"       ,$c6, OP_B      ;    C6 nn    | add $nn
.BYTE   4 *16 | 4,    "[HL]"    ,$86, OP        ;    86       | add [HL]
.BYTE   5 *16 | 5,     "IX+$]"  ,$86, OP_IXR    ; DD 86 nn    | add [IX±$nn]
.BYTE   4 *16 | 6,      "Y+$]"  ,$86, OP_IYR    ; FD 86 nn    | add [IY±$nn]
.BYTE   1 *16 | 4,    "A"       ,$87, OP        ;    87       | add A
.BYTE   1 *16 | 4,    "B"       ,$80, OP        ;    80       | add B
.BYTE   1 *16 | 4,    "C"       ,$81, OP        ;    81       | add C
.BYTE   1 *16 | 4,    "D"       ,$82, OP        ;    82       | add D
.BYTE   1 *16 | 4,    "E"       ,$83, OP        ;    83       | add E
.BYTE   1 *16 | 4,    "H"       ,$84, OP        ;    84       | add H
.BYTE   4 *16 | 5,     "L BC"   ,$09, OP        ;    09       | add HL BC
.BYTE   2 *16 | 7,       "DE"   ,$19, OP        ;    19       | add HL DE
.BYTE   2 *16 | 7,       "HL"   ,$29, OP        ;    29       | add HL HL
.BYTE   2 *16 | 7,       "SP"   ,$39, OP        ;    39       | add HL SP
.BYTE   1 *16 | 4,    "L"       ,$85, OP        ;    85       | add L
.BYTE   5 *16 | 4,    "IX BC"   ,$09, OP_IX     ; DD 09       | add IX BC
.BYTE   2 *16 | 7,       "DE"   ,$19, OP_IX     ; DD 19       | add IX DE
.BYTE   2 *16 | 7,       "IX"   ,$29, OP_IX     ; DD 29       | add IX IX
.BYTE   2 *16 | 7,       "SP"   ,$39, OP_IX     ; DD 39       | add IX SP
.BYTE   1 *16 | 6,      "H"     ,$84, OP_IX     ; DD 84       | add IXH
.BYTE   1 *16 | 6,      "L"     ,$85, OP_IX     ; DD 85       | add IXL
.BYTE   4 *16 | 5,     "Y BC"   ,$09, OP_IY     ; FD 09       | add IY BC
.BYTE   2 *16 | 7,       "DE"   ,$19, OP_IY     ; FD 19       | add IY DE
.BYTE   2 *16 | 7,       "IY"   ,$29, OP_IY     ; FD 29       | add IY IY
.BYTE   2 *16 | 7,       "SP"   ,$39, OP_IY     ; FD 39       | add IY SP
.BYTE   1 *16 | 6,      "H"     ,$84, OP_IY     ; FD 84       | add IYH
.BYTE   1 *16 | 6,      "L"     ,$85, OP_IY     ; FD 85       | add IYL
;-------------------------------------------------------------------------------
.BYTE   4 *16 | 1, "nd $"       ,$e6, OP_B      ;    E6 nn    | and $nn
.BYTE   4 *16 | 4,    "[HL]"    ,$a6, OP        ;    A6       | and [HL]
.BYTE   5 *16 | 5,     "IX+$]"  ,$a6, OP_IXR    ; DD A6 nn    | and [IX±$nn]
.BYTE   4 *16 | 6,      "Y+$]"  ,$a6, OP_IYR    ; FD A6 nn    | and [IY±$nn]
.BYTE   1 *16 | 4,    "A"       ,$a7, OP        ;    A7       | and A
.BYTE   1 *16 | 4,    "B"       ,$a0, OP        ;    A0       | and B
.BYTE   1 *16 | 4,    "C"       ,$a1, OP        ;    A1       | and C
.BYTE   1 *16 | 4,    "D"       ,$a2, OP        ;    A2       | and D
.BYTE   1 *16 | 4,    "E"       ,$a3, OP        ;    A3       | and E
.BYTE   1 *16 | 4,    "H"       ,$a4, OP        ;    A4       | and H
.BYTE   1 *16 | 4,    "L"       ,$a5, OP        ;    A5       | and L
.BYTE   3 *16 | 4,    "IXH"     ,$a4, OP_IX     ; DD A4       | and IXH
.BYTE   1 *16 | 6,      "L"     ,$a5, OP_IX     ; DD A5       | and IXL
.BYTE   2 *16 | 5,     "YH"     ,$a4, OP_IY     ; DD A4       | and IYH
.BYTE   1 *16 | 6,      "L"     ,$a5, OP_IY     ; DD A5       | and IYL
;-------------------------------------------------------------------------------
.BYTE   0

b:
;===============================================================================
; TODO: allow any constant for the bit-number? if a digit 0-9 is in the list,
;       take any expr and match it to the specific digit?
;
.BYTE   6 *16 | 1, "it 0 A"     ,$47, OP_CB     ;    CB 47    | bit 0 A
.BYTE   1 *16 | 6,      "B"     ,$40, OP_CB     ;    CB 40    | bit 0 B
.BYTE   1 *16 | 6,      "C"     ,$41, OP_CB     ;    CB 41    | bit 0 C
.BYTE   1 *16 | 6,      "D"     ,$42, OP_CB     ;    CB 42    | bit 0 D
.BYTE   1 *16 | 6,      "E"     ,$43, OP_CB     ;    CB 43    | bit 0 E
.BYTE   1 *16 | 6,      "H"     ,$44, OP_CB     ;    CB 44    | bit 0 H
.BYTE   1 *16 | 6,      "L"     ,$45, OP_CB     ;    CB 45    | bit 0 L
.BYTE   4 *16 | 6,      "[HL]"  ,$46, OP_CB     ;    CB 46    | bit 0 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$46, OP_CBXR   ; DD CB nn 46 | bit 0 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$46, OP_CBYR   ; FD CB nn 46 | bit 0 [IY±$nn]
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 4,    "1 A"     ,$4f, OP_CB     ;    CB 4F    | bit 1 A
.BYTE   1 *16 | 6,      "B"     ,$48, OP_CB     ;    CB 48    | bit 1 B
.BYTE   1 *16 | 6,      "C"     ,$49, OP_CB     ;    CB 49    | bit 1 C
.BYTE   1 *16 | 6,      "D"     ,$4a, OP_CB     ;    CB 4A    | bit 1 D
.BYTE   1 *16 | 6,      "E"     ,$4b, OP_CB     ;    CB 4B    | bit 1 E
.BYTE   1 *16 | 6,      "H"     ,$4c, OP_CB     ;    CB 4C    | bit 1 H
.BYTE   1 *16 | 6,      "L"     ,$4d, OP_CB     ;    CB 4D    | bit 1 L
.BYTE   4 *16 | 6,      "[HL]"  ,$4e, OP_CB     ;    CB 4E    | bit 1 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$4e, OP_CBXR   ; DD CB nn 4E | bit 1 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$4e, OP_CBYR   ; FD CB nn 4E | bit 1 [IY±$nn]
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 4,    "2 A"     ,$57, OP_CB     ;    CB 57    | bit 2 A
.BYTE   1 *16 | 6,      "B"     ,$50, OP_CB     ;    CB 50    | bit 2 B
.BYTE   1 *16 | 6,      "C"     ,$51, OP_CB     ;    CB 51    | bit 2 C
.BYTE   1 *16 | 6,      "D"     ,$52, OP_CB     ;    CB 52    | bit 2 D
.BYTE   1 *16 | 6,      "E"     ,$53, OP_CB     ;    CB 53    | bit 2 E
.BYTE   1 *16 | 6,      "H"     ,$54, OP_CB     ;    CB 54    | bit 2 H
.BYTE   1 *16 | 6,      "L"     ,$55, OP_CB     ;    CB 55    | bit 2 L
.BYTE   4 *16 | 6,      "[HL]"  ,$56, OP_CB     ;    CB 56    | bit 2 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$56, OP_CBXR   ; DD CB nn 56 | bit 2 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$56, OP_CBYR   ; FD CB nn 56 | bit 2 [IY±$nn]
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 4,    "3 A"     ,$5f, OP_CB     ;    CB 5F    | bit 3 A
.BYTE   1 *16 | 6,      "B"     ,$58, OP_CB     ;    CB 58    | bit 3 B
.BYTE   1 *16 | 6,      "C"     ,$59, OP_CB     ;    CB 59    | bit 3 C
.BYTE   1 *16 | 6,      "D"     ,$5a, OP_CB     ;    CB 5A    | bit 3 D
.BYTE   1 *16 | 6,      "E"     ,$5b, OP_CB     ;    CB 5B    | bit 3 E
.BYTE   1 *16 | 6,      "H"     ,$5c, OP_CB     ;    CB 5C    | bit 3 H
.BYTE   1 *16 | 6,      "L"     ,$5d, OP_CB     ;    CB 5D    | bit 3 L
.BYTE   4 *16 | 6,      "[HL]"  ,$5e, OP_CB     ;    CB 5E    | bit 3 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$5e, OP_CBXR   ; DD CB nn 5E | bit 3 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$5e, OP_CBYR   ; FD CB nn 5E | bit 3 [IY±$nn]
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 4,    "4 A"     ,$67, OP_CB     ;    CB 67    | bit 4 A
.BYTE   1 *16 | 6,      "B"     ,$60, OP_CB     ;    CB 60    | bit 4 B
.BYTE   1 *16 | 6,      "C"     ,$61, OP_CB     ;    CB 61    | bit 4 C
.BYTE   1 *16 | 6,      "D"     ,$62, OP_CB     ;    CB 62    | bit 4 D
.BYTE   1 *16 | 6,      "E"     ,$63, OP_CB     ;    CB 63    | bit 4 E
.BYTE   1 *16 | 6,      "H"     ,$64, OP_CB     ;    CB 64    | bit 4 H
.BYTE   1 *16 | 6,      "L"     ,$65, OP_CB     ;    CB 65    | bit 4 L
.BYTE   4 *16 | 6,      "[HL]"  ,$66, OP_CB     ;    CB 66    | bit 4 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$66, OP_CBXR   ; DD CB nn 66 | bit 4 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$66, OP_CBYR   ; FD CB nn 66 | bit 4 [IY±$nn]
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 4,    "5 A"     ,$6f, OP_CB     ;    CB 6F    | bit 5 A
.BYTE   1 *16 | 6,      "B"     ,$68, OP_CB     ;    CB 68    | bit 5 B
.BYTE   1 *16 | 6,      "C"     ,$69, OP_CB     ;    CB 69    | bit 5 C
.BYTE   1 *16 | 6,      "D"     ,$6a, OP_CB     ;    CB 6A    | bit 5 D
.BYTE   1 *16 | 6,      "E"     ,$6b, OP_CB     ;    CB 6B    | bit 5 E
.BYTE   1 *16 | 6,      "H"     ,$6c, OP_CB     ;    CB 6C    | bit 5 H
.BYTE   1 *16 | 6,      "L"     ,$6d, OP_CB     ;    CB 6D    | bit 5 L
.BYTE   4 *16 | 6,      "[HL]"  ,$6e, OP_CB     ;    CB 6E    | bit 5 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$6e, OP_CBXR   ; DD CB nn 6E | bit 5 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$6e, OP_CBYR   ; FD CB nn 6E | bit 5 [IY±$nn]
;-------------------------------------------------------------------------------
.BYTE   3 *16 | 4,    "6 A"     ,$77, OP_CB     ;    CB 77    | bit 6 A
.BYTE   1 *16 | 6,      "B"     ,$70, OP_CB     ;    CB 70    | bit 6 B
.BYTE   1 *16 | 6,      "C"     ,$71, OP_CB     ;    CB 71    | bit 6 C
.BYTE   1 *16 | 6,      "D"     ,$72, OP_CB     ;    CB 72    | bit 6 D
.BYTE   1 *16 | 6,      "E"     ,$73, OP_CB     ;    CB 73    | bit 6 E
.BYTE   1 *16 | 6,      "H"     ,$74, OP_CB     ;    CB 74    | bit 6 H
.BYTE   1 *16 | 6,      "L"     ,$75, OP_CB     ;    CB 75    | bit 6 L
.BYTE   4 *16 | 6,      "[HL]"  ,$76, OP_CB     ;    CB 76    | bit 6 [HL]
.BYTE   5 *16 | 7,       "IX+$]",$76, OP_CBXR   ; DD CB nn 76 | bit 6 [IX±$nn]
.BYTE   4 *16 | 8,        "Y+$]",$76, OP_CBYR   ; FD CB nn 76 | bit 6 [IY±$nn]
;-------------------------------------------------------------------------------
